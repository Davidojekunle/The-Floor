# Database (server -> Postgres). 127.0.0.1 avoids a slow IPv6 fallback on Windows.
DATABASE_URL=postgresql+psycopg://taskroom:taskroom@127.0.0.1:5432/taskroom

# At least 32 bytes: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-bytes

# Sessions
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_DAYS=30
# false for plain-http local dev (Safari refuses Secure cookies on http). Always true in production.
REFRESH_COOKIE_SECURE=false

# The frontend's origin. Keep the SAME host name as the API (both localhost), or the
# session cookie won't be sent: localhost:5173 -> 127.0.0.1:8000 counts as cross-site.
CORS_ORIGINS=http://localhost:5173

# Where links in emails point when the request's Origin isn't one of CORS_ORIGINS.
FRONTEND_URL=http://localhost:5173

# Email. "console" prints emails to the server log (dev). "smtp" sends them for real.
EMAIL_BACKEND=console
EMAIL_FROM=The Floor <no-reply@localhost>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true

# Rate limits (in memory, per process). Behind a reverse proxy, list its IPs so the
# real client address is read from X-Forwarded-For. Never list anything else.
RATE_LIMIT_ENABLED=true
TRUSTED_PROXIES=

# Notifications. Unsubscribe links in emails point at the API itself, so set its public address.
PUBLIC_API_URL=http://localhost:8000
# NOTIFICATION_EMAIL_DELAY_SECONDS=120   # emails are grouped within this window
# DIGEST_HOUR=8                          # daily digest time, in each person's own timezone

# Browser push notifications. With no key set, the server makes one on first start and keeps it
# in the database. VAPID_SUBJECT is how push services can contact you (a mailto: or the site's URL).
# PUSH_ENABLED=true
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Serve the built web app (frontend-v2/dist) from the API, so both share one address.
# The Dockerfile sets this; leave it unset for local development with `npm run dev`.
# FRONTEND_DIST=../frontend-v2/dist
